<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Argon" Version="0.38.2" />
    <PackageVersion Include="Argon.Xml" Version="0.38.2" />
    <PackageVersion Include="Flurl" Version="4.0.0" />
    <PackageVersion Include="Flurl.Http" Version="4.0.2" />
    <PackageVersion Include="MarkdownSnippets.MsBuild" Version="30.0.1" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="Polyfill" Version="11.4.5" />
    <PackageVersion Include="ProjectDefaults" Version="1.0.190" />
    <PackageVersion Include="Sbom" Version="1.0.0" />
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="11.0.1" />
    <PackageVersion Include="Verify" Version="33.6.0" />
    <PackageVersion Include="Verify.Http" Version="9.0.0" />
    <PackageVersion Include="Verify.XunitV3" Version="33.6.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="DiffEngine" Version="21.1.0" />
    <PackageVersion Include="EmptyFiles" Version="8.20.1" />
    <PackageVersion Include="SimpleInfoName" Version="3.2.1" />
  </ItemGroup>
</Project>
